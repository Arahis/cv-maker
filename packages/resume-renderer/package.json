{
  "name": "@cv-maker/resume-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npx @tailwindcss/cli -i renderer.css -o dist/renderer.css --minify"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pagination.css": "./src/pagination/pagination.css",
    "./geometry": {
      "types": "./dist/pagination/geometry.d.ts",
      "default": "./dist/pagination/geometry.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "dependencies": {
    "@cv-maker/shared": "*",
    "@lexical/html": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "lexical": "^0.39.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
