{
  "name": "cv-maker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:pdf",
    "dev:web": "npm run -w apps/web dev",
    "build:web": "npm run -w apps/web build",
    "lint:web": "npm run -w apps/web lint",
    "dev:pdf": "npm run -w apps/pdf-api dev",
    "deploy:pdf": "npm run -w apps/pdf-api deploy",
    "build:pdf": "npm run build:pdf-css -w web"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1"
  }
}
