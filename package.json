{
  "name": "cv-maker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "scripts": {
    "build": "npm run build:web",
    "dev:web": "npm run -w apps/web dev",
    "dev:api": "npm run -w apps/api dev",
    "build:web": "npm run -w apps/web build",
    "build:cf:web": "npm run -w apps/web build:cf",
    "preview:web": "npm run -w apps/web preview",
    "deploy:web": "npm run -w apps/web deploy",
    "cf-typegen:web": "npm run -w apps/web cf-typegen",
    "lint:web": "npm run -w apps/web lint",
    "dev:pdf": "npm run -w apps/api dev",
    "deploy:pdf": "npm run -w apps/api deploy"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "tailwindcss": "^4.2.1"
  }
}
